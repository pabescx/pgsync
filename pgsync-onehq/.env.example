# These two build the index name: <base>_${APP_ENV}_<timestamp>
# resolve_schema.py fails hard if either is unset rather than silently resolving
# to an empty string -- the same value also names the replication slot and the
# checkpoint, so an empty one is a valid but wrong name.
APP_ENV=dev
DB_NAME=readygop

PG_URL=postgresql://postgres:postgres@host.docker.internal:5432/readygop
ELASTICSEARCH_URL=http://elasticsearch:9200
REDIS_HOST=redis
REDIS_PORT=6379

# Keeps the checkpoint in Redis instead of on disk: no volume to mount, and its
# appearance is the signal the alias watcher waits on before promoting an alias.
REDIS_CHECKPOINT=true

PYTHONPATH=/app

# Status line interval, in seconds.
LOG_INTERVAL=10

# Consumer scaling. NUM_WORKERS is threads *per index* inside each container.
PGSYNC_CONSUMERS=2
NUM_WORKERS=2

# How often the alias watcher polls, in seconds.
ALIAS_WATCHER_INTERVAL=5
